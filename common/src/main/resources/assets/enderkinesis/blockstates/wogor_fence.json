{
  "multipart": [
    {
      "apply": [
        {
          "model": "enderkinesis:block/wogor_fence_post"
        },
        {
          "model": "enderkinesis:block/wogor_fence_post_alt"
        }
      ]
    },
    {
      "when": {
        "north": "true"
      },
      "apply": [
        {
          "model": "enderkinesis:block/wogor_fence_side",
          "uvlock": true
        },
        {
          "model": "enderkinesis:block/wogor_fence_side_alt",
          "uvlock": true
        }
      ]
    },
    {
      "when": {
        "east": "true"
      },
      "apply": [
        {
          "model": "enderkinesis:block/wogor_fence_side",
          "y": 90,
          "uvlock": true
        },
        {
          "model": "enderkinesis:block/wogor_fence_side_alt",
          "y": 90,
          "uvlock": true
        }
      ]
    },
    {
      "when": {
        "south": "true"
      },
      "apply": [
        {
          "model": "enderkinesis:block/wogor_fence_side",
          "y": 180,
          "uvlock": true
        },
        {
          "model": "enderkinesis:block/wogor_fence_side_alt",
          "y": 180,
          "uvlock": true
        }
      ]
    },
    {
      "when": {
        "west": "true"
      },
      "apply": [
        {
          "model": "enderkinesis:block/wogor_fence_side",
          "y": 270,
          "uvlock": true
        },
        {
          "model": "enderkinesis:block/wogor_fence_side_alt",
          "y": 270,
          "uvlock": true
        }
      ]
    }
  ]
}